{
  "buildCommand": "cd client && npm run build",
  "outputDirectory": "client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/uploads/:match*",
      "destination": "https://skillups.tricubedigitalsolutions.com/uploads/:match*"
    },
    {
      "source": "/api/:match*",
      "destination": "https://skillups.tricubedigitalsolutions.com/api/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

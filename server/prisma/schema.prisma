  FAILED
  REFUNDED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  REJECTED
}

enum DeliveryMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
  COMPLETED
}

enum HackathonMode {
  ONLINE
  OFFLINE
  HYBRID
}

enum RegistrationStatus {
  REGISTERED
  CONFIRMED
  CANCELLED
}

enum EmailDeliveryStatus {
  PENDING
  SENT
  FAILED
  RETRYING
}

enum course_feedbacks_feedbackType {
  STUDENT
  MENTOR
}

enum course_feedbacks_status {
  PENDING
  APPROVED
  REJECTED
}

model GalleryItem {
  id           String   @id @default(cuid())
  title        String
  label        String
  description  String?  @db.Text
  imageUrl     String   @db.Text
  link         String?  @default("#")
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([isActive, displayOrder])
  @@map("gallery_items")
}

model GallerySetting {
  id           String   @id @default("default")
  isEnabled    Boolean  @default(true)
  sectionTitle String   @default("Discover. Learn. Create.")
  sectionBadge String   @default("EXPLORE SKILLUP")
  sectionDesc  String   @default("Explore our learning experiences, student projects, workshops and technical programs.")
  defaultIndex Int      @default(0)
  updatedAt    DateTime @updatedAt

  @@map("gallery_settings")
}

model AchievementCategory {
  id           String        @id @default(cuid())
  name         String        @unique
  slug         String        @unique
  description  String?       @db.Text
  displayOrder Int           @default(0)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  achievements Achievement[]

  @@map("achievement_categories")
}

model Achievement {
  id               String               @id @default(cuid())
  title            String
  slug             String               @unique
  shortSummary     String?              @db.Text
  description      String               @db.Text
  coverImage       String               @db.Text
  eventDate        DateTime?
  location         String?
  isFeatured       Boolean              @default(false)
  isPublished      Boolean              @default(true)
  displayOrder     Int                  @default(0)
  categoryId       String?
  category         AchievementCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images           AchievementImage[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([categoryId])
  @@index([isPublished, displayOrder])
  @@map("achievements")
}

model AchievementImage {
  id            String      @id @default(cuid())
  achievementId String
  achievement   Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  imageUrl      String      @db.Text
  caption       String?
  displayOrder  Int         @default(0)
  createdAt     DateTime    @default(now())

  @@index([achievementId])
  @@map("achievement_images")
}


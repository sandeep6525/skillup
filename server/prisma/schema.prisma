  DRAFT
  PUBLISHED
  ARCHIVED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
  MANUAL_REVIEW_REQUIRED
  REFUND_REQUESTED
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum LiveClassStatus {
  SCHEDULED
  LIVE
  COMPLETED
  CANCELLED
}

enum SubmissionStatus {
  PENDING
  SUBMITTED
  UNDER_REVIEW
  NEEDS_REVISION
  GRADED
  LATE
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  PAYMENT
  COURSE
  BOOKING
}

enum BatchStatus {
  UPCOMING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum MentorAssignmentScope {
  COURSE_WIDE
  SPECIFIC_BATCH
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum MaterialType {
  PDF
  DOCUMENT
  PRESENTATION
  CODE_FILE
  IMAGE
  EXTERNAL_LINK
  VIDEO_RECORDING
}

enum QuestionType {

# ===================================================
# SkillUp Backend (.gitignore) - Node.js + Express + Prisma
# ===================================================

# Dependencies
node_modules/
.pnp
.pnp.js

# TypeScript / Build output
dist/
build/
*.tsbuildinfo

# Environment & Secrets (NEVER commit live secrets, JWT secrets, DB URLs)
.env
.env.local
.env.development
.env.test
.env.production
.env.*.local
*.env

# Keep example template committed
!.env.example

# Database files & migrations
*.sqlite
*.sqlite3
*.db
*.db-journal
backups/
*.sql
*.sql.gz
*.dump

# File Uploads & User Generated Content
uploads/*
!uploads/.gitkeep
temp/
tmp/

# Logs & Debugging
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Unit & Integration Test Coverage
coverage/
.nyc_output/

# IDE, OS & System Files
.DS_Store
Thumbs.db
[Dd]esktop.ini
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo

# Runtime & Process files
pids/
*.pid
*.seed
*.pid.lock
